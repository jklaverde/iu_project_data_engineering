# ---- Dataset fetch (dataset-init, one-shot) ----
# The Kaggle dataset (garystafford/environmental-sensor-data-132k) is public,
# so dataset-init downloads it with no credentials at all in most cases.
# These are only a fallback for if Kaggle ever requires auth for this
# dataset - get them from https://www.kaggle.com/settings -> API -> Create
# New Token if dataset-init ever fails with an auth error.
KAGGLE_USERNAME=
KAGGLE_KEY=

# ---- Kafka ----
KAFKA_EXTERNAL_PORT=9092
KAFKA_TOPIC_NAME=sensor-readings
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICATION_FACTOR=1

# ---- Cassandra ----
CASSANDRA_PORT=9042

# ---- Spark ----
SPARK_MASTER_PORT=7077
SPARK_MASTER_UI_PORT=8090
SPARK_WORKER_UI_PORT=8091

# ---- Prometheus ----
PROMETHEUS_PORT=9090

# ---- Grafana ----
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme   # REQUIRED - set a real secret in your own .env; never commit the real value

# ---- kafka-ui (dev convenience) ----
KAFKA_UI_PORT=8080

# ---- Producer (P2 - ingestion) ----
PRODUCER_RATE_MSGS_PER_SEC=100
PRODUCER_ANOMALY_PROBABILITY=0.05
PRODUCER_ANOMALY_SIGMA_MULTIPLIER=4.0
PRODUCER_DATASET_CSV_PATH=/data/iot_telemetry_data.csv
PRODUCER_REPLAY_ROW_LIMIT=0   # 0 = replay full dataset; set e.g. 2000 for a fast dev hand-over
PRODUCER_STATE_PORT=8001      # host port -> producer's internal state HTTP server (container port 8000)
PRODUCER_LOG_LEVEL=INFO

# ---- Spark job (P3 - processing) ----
SPARK_JOB_TRIGGER_INTERVAL=30 seconds
SPARK_JOB_WATERMARK_1M=2 minutes
SPARK_JOB_WATERMARK_1H=10 minutes
SPARK_JOB_AGG_1H_WINDOW_DURATION=1 hour
SPARK_JOB_ANOMALY_SIGMA_N=3.0
SPARK_JOB_ANOMALY_EWMA_ALPHA=0.001
SPARK_JOB_ANOMALY_CEILING_SAFETY_MULTIPLIER=1.5
SPARK_JOB_BASELINE_CSV_PATH=/data/iot_telemetry_data.csv
SPARK_JOB_STATE_PORT=8002      # host port -> spark job's internal state HTTP server (container port 8000)
SPARK_JOB_DRIVER_UI_PORT=4040  # host port -> Spark driver UI (Structured Streaming tab), manual inspection only
SPARK_JOB_LOG_LEVEL=INFO

# ---- Kafka exporter (P4 - observability, KPI-1) ----
KAFKA_EXPORTER_PORT=9308      # host port -> kafka-exporter /metrics (container port 9308)

# ---- Cassandra JMX exporter (P4 - observability, KPI-4) ----
CASSANDRA_JMX_EXPORTER_PORT=7070   # host port -> jmx_exporter javaagent inside the cassandra container

# ---- node-exporter (P4 - observability, KPI-4 cross-check) ----
NODE_EXPORTER_PORT=9100

# ---- Grafana Cassandra datasource plugin (P4) ----
GRAFANA_CASSANDRA_PLUGIN_VERSION=3.3.0

# ---- Backend web app (P5) ----
BACKEND_PORT=8000
BACKEND_ADMIN_USERNAME=admin
BACKEND_ADMIN_PASSWORD=changeme   # REQUIRED - set a real secret in your own .env; never commit the real value
BACKEND_SESSION_SECRET=changeme-generate-with-openssl-rand-hex-32   # REQUIRED - e.g. `openssl rand -hex 32`
BACKEND_SESSION_TTL_SECONDS=43200
BACKEND_COOKIE_SECURE=false
BACKEND_POLL_INTERVAL_SECONDS=2
BACKEND_HEALTH_CHECK_INTERVAL_SECONDS=5
BACKEND_KNOWN_DEVICE_IDS=b8:27:eb:bf:9d:51,00:0f:00:70:91:0a,1c:bf:ce:15:ec:4d
BACKEND_LOG_LEVEL=INFO
