.venv/
.env

# Developer-facing build-process notes (local reference only, not part of the shipped repo)
development_notes/

# Claude Code local runtime/session state (not part of the shipped repo)
.claude/

# Developer-only local HTML docs (file-structure map, message-lifecycle walkthrough) —
# generated for local reading, not part of the shipped repo
docs/internal/

# Python build artifacts
__pycache__/
*.pyc

# Kaggle dataset — downloadable via kaggle_repository/download_repository.py, not committed
kaggle_repository/.complete/
kaggle_repository/*.csv

# Frontend build artifacts (P5) — package-lock.json IS committed (NFR-10.3)
frontend/node_modules/
frontend/dist/
frontend/tsconfig.tsbuildinfo

# k8s/base/kustomization.yaml's configMapGenerator sources these from here
# (kustomize refuses to reference files outside the kustomization root) —
# k8s/deploy.sh copies them from infra/ before every apply, so infra/ stays
# the one committed source of truth and this directory is never committed.
k8s/base/generated/
